# ============================================================================
# secrets.yaml template
# ============================================================================
# Copy to secrets.yaml (same directory) and replace every value.
# secrets.yaml is gitignored and must never be committed.
#
# Every key below is referenced by Halo-v1.yaml as shipped. The wg_* keys are
# needed even if you never use WireGuard: wireguard.yaml cannot be commented
# out today (docs/ARCHITECTURE.md "Known gaps" #2). Placeholders are fine
# while the "Enable WireGuard" switch stays off, which is the default.
# ============================================================================

# --- WiFi (Halo-v1.yaml substitutions wifi_ssid / wifi_password) ---
wifihome_ssid: "YourSSID"
wifihome_password: "YourWiFiPassword"

# --- Home Assistant REST access (hourly-forecast fallback, printer cover image) ---
# Prefer HA's LAN IP over a hostname if the device is on an isolated VLAN.
ha_url: "http://192.0.2.10:8123"
# Profile -> Security -> Long-Lived Access Tokens
ha_token: "your_long_lived_access_token"

# --- ESPHome API and OTA ---
# Generate with: openssl rand -base64 32
api_encryption_key: "replace_with_32_byte_base64_key="
ota_password: "choose_an_ota_password"

# --- WireGuard (features/wireguard/wireguard.yaml) ---
wg_address: "10.6.0.2"               # this device's tunnel address
wg_netmask: "255.255.255.0"
wg_prikey: "device_private_key_base64="     # wg genkey
wg_pubkey: "server_public_key_base64="
wg_shrdkey: "preshared_key_base64="         # wg genpsk
wg_peerendpt: "vpn.example.com"      # server hostname or IP
wg_peerport: "51820"
wg_allowed_ips: "10.6.0.0/24"        # "0.0.0.0/0" routes everything through the tunnel

# --- Optional: only halo-v1-79e384.yaml's alternate-network selector uses these ---
# my_alt_ssid: "OtherSSID"
# my_alt_password: "OtherPassword"
